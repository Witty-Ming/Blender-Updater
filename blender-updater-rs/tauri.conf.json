{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlenderUpdater",
  "version": "0.3.0",
  "identifier": "com.blenderupdater.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Blender 更新器",
        "width": 1160,
        "height": 780,
        "minWidth": 1020,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "decorations": false,
        "shadow": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
